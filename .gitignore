# Rust
/target/
**/target/
Cargo.lock.bak

# Node / Vite / React
node_modules/
dist/
.vite/
*.tsbuildinfo

# Tauri (the shell lives in crates/modlab-ui, not a top-level src-tauri/)
crates/modlab-ui/gen/

# Env / secrets
.env
.env.*
!.env.example

# OS
Thumbs.db
.DS_Store

# Editors
.vscode/*
!.vscode/extensions.json
.idea/

# ModLab runtime data (never versioned — this is user mod data, not source)
/data/
*.db
*.db-wal
*.db-shm

# Local CLI / Tauri-cwd sandbox (default --data-root when F:\ModLab is absent)
.modlab-dev/

# Forge/NeoForge installer logs accidentally written under crates/modlab-ui cwd
*-installer.jar.log
crates/modlab-ui/*.log

# Claude Code local scratch
.claude/settings.local.json

# Local files kept out of the repository
/tauri-dev.log

# Python bytecode
__pycache__/
